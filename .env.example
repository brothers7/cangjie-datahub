# ===== 应用数据库（PostgreSQL）=====
POSTGRES_USER=data_agent
POSTGRES_PASSWORD=data_agent_pg_pw
POSTGRES_DB=data_agent

# 应用库连接串。Docker 内默认走下面这行注释掉的值；本地开发可用 SQLite：
# APP_DB_URL=postgresql+asyncpg://data_agent:data_agent_pg_pw@postgres:5432/data_agent
APP_DB_URL=postgresql+asyncpg://data_agent:data_agent_pg_pw@postgres:5432/data_agent

# ===== 安全密钥（生产环境必须替换）=====
# JWT 签名密钥，>= 32 随机字符
JWT_SECRET=please-change-me-to-a-random-32plus-char-string
# AES-256-GCM 主密钥：32 字节的 base64。生成方式：
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=

# ===== 默认管理员 =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin12345

# ===== Qdrant 向量库 =====
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ===== 联网检索（Tavily，可空；未配置则联网检索能力自动关闭）=====
TAVILY_API_KEY=

# ===== 演示库 =====
DEMO_DB_PATH=/app/demo_data/ecom_demo.db
DEMO_DB_ENABLED=true

# ===== 查询性能与安全 =====
QUERY_CACHE_TTL_SEC=300
SQL_MAX_ROWS=10000
QUERY_TIMEOUT_SEC=30
SCAN_BATCH_SIZE=20

# ===== 服务端口 =====
BACKEND_PORT=9000
FRONTEND_PORT=8080
