# ========================================================================
# !! 生产环境必须修改（不改 = 重大安全风险）!!
#   1. JWT_SECRET               —— 随机 >= 32 字符强密钥
#   2. SECRET_ENCRYPTION_KEY    —— base64 编码的 32 字节主密钥（生成命令见下）
#   3. POSTGRES_PASSWORD        —— 数据库口令（同时影响下方 APP_DB_URL）
#   4. APP_ENV=production       —— 开启生产模式：以上密钥不合规将拒绝启动
#   5. DEFAULT_ADMIN_PASSWORD   —— 首次登录后立即在界面修改管理员密码
# ========================================================================

# ===== 运行环境与时区 =====
# dev / production。production 下弱密钥（默认 JWT_SECRET、空 SECRET_ENCRYPTION_KEY）拒绝启动
APP_ENV=dev
# 应用与调度引擎使用的时区（IANA 名称），同时作为后端容器 TZ
APP_TZ=Asia/Shanghai

# ===== 应用数据库（PostgreSQL）=====
POSTGRES_USER=data_agent
POSTGRES_PASSWORD=data_agent_pg_pw
POSTGRES_DB=data_agent

# 应用库连接串。Docker 内默认走下面这行注释掉的值；本地开发可用 SQLite：
# APP_DB_URL=postgresql+asyncpg://data_agent:data_agent_pg_pw@postgres:5432/data_agent
APP_DB_URL=postgresql+asyncpg://data_agent:data_agent_pg_pw@postgres:5432/data_agent

# ===== 安全密钥（生产环境必须替换）=====
# JWT 签名密钥，>= 32 随机字符
JWT_SECRET=please-change-me-to-a-random-32plus-char-string
# AES-256-GCM 主密钥：32 字节的 base64。生成方式：
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=

# ===== 默认管理员 =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin12345

# ===== 登录限流 =====
# 连续密码错误达到该次数后锁定账号（默认 5）
LOGIN_MAX_FAILS=5
# 锁定时长（分钟，默认 10）
LOGIN_LOCK_MINUTES=10

# ===== Qdrant 向量库 =====
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ===== 联网检索（Tavily，可空；未配置则联网检索能力自动关闭）=====
TAVILY_API_KEY=

# ===== 告警 Webhook =====
# LLM 调用彻底失败（重试+降级链后仍失败）时向该 URL POST JSON 告警；
# 留空则关闭。同一配置 5 分钟内最多告警 1 次。报文格式见 docs/operations.md
ALERT_WEBHOOK_URL=

# ===== 演示库 =====
DEMO_DB_PATH=/app/demo_data/ecom_demo.db
DEMO_DB_ENABLED=true

# ===== 查询性能与安全 =====
QUERY_CACHE_TTL_SEC=300
SQL_MAX_ROWS=10000
QUERY_TIMEOUT_SEC=30
SCAN_BATCH_SIZE=20

# ===== Agent / Skill 限额 =====
# 建模编码代理单轮会话最大步数（默认 8）
AGENT_MAX_STEPS=8
# Python 型 Skill 沙箱执行超时（秒，默认 30）
SKILL_PYTHON_TIMEOUT_SEC=30

# ===== 后台任务维护 =====
# RUNNING 超过该时长（分钟）的元数据扫描任务视为进程崩溃遗留，启动时回收为 FAILED（默认 30）
STALE_SCAN_JOB_MINUTES=30
# 内置调度器补跑（catchup）的回溯窗口（小时，默认 24）
SCHEDULER_CATCHUP_HOURS=24

# ===== 服务运行 =====
# uvicorn worker 进程数（默认 1；内置调度器为进程内单实例，调大前请确认部署形态）
UVICORN_WORKERS=1

# ===== 服务端口 =====
BACKEND_PORT=9000
FRONTEND_PORT=8080
